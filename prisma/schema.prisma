generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  COORDENADOR
  CANDIDATO
}

enum TipoEleicao {
  MUNICIPAL
  ESTADUAL
}

enum TipoApuracao {
  MAJORITARIO
  PROPORCIONAL
}

// Relatório analítico gerado por IA (aba Relatórios): parâmetros do pedido
// e conteúdo estruturado (JSON) para reexibição e PDF.
model Relatorio {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  tipo       String
  titulo     String
  parametros String
  conteudo   String
  modelo     String?
  createdAt  DateTime @default(now())
}

model User {
  id                String             @id @default(cuid())
  nome              String
  email             String             @unique
  passwordHash      String
  role              Role               @default(COORDENADOR)
  regiaoId          String?
  regiao            Regiao?            @relation(fields: [regiaoId], references: [id])
  candidatoId       String?
  candidato         Candidato?         @relation(fields: [candidatoId], references: [id])
  ativo             Boolean            @default(true)
  expiresAt         DateTime?
  criadoPorId       String?
  criadoPor         User?              @relation("UsuariosCriados", fields: [criadoPorId], references: [id])
  criados           User[]             @relation("UsuariosCriados")
  favoritosApuracao ApuracaoFavorito[]
  favoritosPoliticos PoliticoFavorito[]
  relatorios        Relatorio[]
  cenariosMeta      CenarioMeta[]
  createdAt         DateTime           @default(now())
}

// Disputas que o usuário acompanha na aba Apuração: cada favorito vira um
// card ao vivo (eleição do índice do TSE + cargo + município opcional).
model ApuracaoFavorito {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  rotulo       String
  ano          String
  eleicaoCd    String
  cargoCd      String
  municipioTse String?
  ordem        Int      @default(0)
  createdAt    DateTime @default(now())

  @@unique([userId, eleicaoCd, cargoCd, municipioTse])
}

model Eleicao {
  id        String      @id @default(cuid())
  ano       Int
  uf        String
  tipo      TipoEleicao
  cargos    Cargo[]
  createdAt DateTime    @default(now())
}

// Para cargos municipais (Prefeito/Vereador), municipioId identifica a
// qual município a disputa pertence. Para cargos estaduais (Governador/
// Deputado), municipioId fica nulo pois a disputa é em todo o estado.
model Cargo {
  id           String        @id @default(cuid())
  nome         String
  tipoApuracao TipoApuracao
  vagas        Int           @default(1)
  eleicaoId    String
  eleicao      Eleicao       @relation(fields: [eleicaoId], references: [id])
  municipioId  String?
  municipio    Municipio?    @relation(fields: [municipioId], references: [id])
  // Disputa sub judice: totalização suspensa/pendente por decisão da
  // Justiça Eleitoral — exibida com um indicativo nas telas.
  subJudice    Boolean       @default(false)
  // Nota judicial (ex.: "Retotalizada em 24/09/2025 por decisão da JE").
  obsJudicial  String?
  candidatos   Candidato[]
  votosLegenda VotoLegenda[]
  cenariosMeta CenarioMeta[]
}

model Partido {
  id                   String         @id @default(cuid())
  sigla                String         @unique
  nome                 String
  numero               Int
  // Dados institucionais pesquisados (não vêm do TSE) — usados na aba
  // "Partidos Políticos". Podem ficar nulos quando não encontrados.
  presidenteNacional   String?
  presidenteEstadualPA String?
  // Contatos e composição da executiva estadual vigente (SGIP/TSE).
  telefoneEstadualPA   String?
  emailEstadualPA      String?
  // JSON [{cargo, nome, inicio}] — executiva estadual vigente no PA.
  executivaEstadualPA  String?
  federacao            String?
  federacaoMembros     String?
  espectro             String?
  fundacao             Int?
  figurasNotaveis      String?
  // Bancadas no Congresso Nacional (senado.leg.br / dadosabertos.camara.
  // leg.br), atualizadas por script — mudam na janela partidária.
  senadoresNacional    Int?
  deputadosNacional    Int?
  candidatos           Candidato[]
  trocasComoOrigem     TrocaPartido[] @relation("TrocaPartidoOrigem")
  trocasComoDestino    TrocaPartido[] @relation("TrocaPartidoDestino")
  votosLegenda         VotoLegenda[]
  direcoesMunicipais   DirecaoMunicipalPartido[]
  convencao            Convencao?
  preCandidatos        PreCandidato[]
}

model Candidato {
  id            String         @id @default(cuid())
  nome          String
  // Identidade civil do TSE (NM_CANDIDATO/NR_CPF_CANDIDATO): o nome de
  // urna se repete entre pessoas diferentes, então o vínculo de um mesmo
  // político entre eleições é feito pelo CPF (ou nome completo).
  nomeCompleto  String?
  cpf           String?
  numero        Int
  cargoId       String
  cargo         Cargo          @relation(fields: [cargoId], references: [id])
  partidoId     String
  partido       Partido        @relation(fields: [partidoId], references: [id])
  // Vice (Prefeito/Governador) e suplentes de Senador: concorrem na mesma
  // chapa e são eleitos ou não junto com o titular, sem votação própria —
  // por isso ficam como campos simples aqui, não como um Candidato separado.
  viceNome      String?
  viceNumero    Int?
  // Situação oficial do TSE (DS_SIT_TOT_TURNO indica "eleito"): quem de
  // fato assumiu, incluindo eleitos por média — mais confiável que
  // recalcular o quociente a partir só dos votos nominais.
  eleito        Boolean        @default(false)
  resultados    Resultado[]
  votosLocais   VotoLocal[]
  users         User[]
  trocasPartido TrocaPartido[]
  favoritosPoliticos PoliticoFavorito[]
}

// Registro histórico real de mudança de partido de um candidato (data
// efetiva + motivo opcional). Ao registrar uma troca, o partido atual do
// candidato (Candidato.partidoId) é atualizado para refletir a nova
// filiação nos cálculos de quociente; este log preserva o histórico.
model TrocaPartido {
  id               String    @id @default(cuid())
  candidatoId      String
  candidato        Candidato @relation(fields: [candidatoId], references: [id])
  partidoOrigemId  String
  partidoOrigem    Partido   @relation("TrocaPartidoOrigem", fields: [partidoOrigemId], references: [id])
  partidoDestinoId String
  partidoDestino   Partido   @relation("TrocaPartidoDestino", fields: [partidoDestinoId], references: [id])
  data             DateTime
  motivo           String?
  createdAt        DateTime  @default(now())
}

model Regiao {
  id         String      @id @default(cuid())
  nome       String      @unique
  municipios Municipio[]
  users      User[]
}

model Municipio {
  id                 String             @id @default(cuid())
  nome               String
  codigoIbge         String?            @unique
  codigoTse          String?            @unique
  // População residente do Censo 2022 (IBGE, agregado 4709/variável 93).
  populacao          Int?
  // Ficha do IBGE: área territorial do Censo 2022 (agregado 4714/6318),
  // gentílico, ano de criação do município e resumo histórico (biblioteca
  // do IBGE Cidades) — preenchidos por scripts/importar-historia.ts.
  areaKm2            Float?
  gentilico          String?
  anoCriacao         Int?
  historia           String?
  regiaoId           String
  regiao             Regiao             @relation(fields: [regiaoId], references: [id])
  resultados         Resultado[]
  cargos             Cargo[]
  colegiosEleitorais ColegioEleitoral[]
  eleitorado         Eleitorado[]
  votosLegenda       VotoLegenda[]
  direcoesPartidarias DirecaoMunicipalPartido[]

  @@unique([nome, regiaoId])
}

// Número de eleitores aptos por município/ano, conforme "perfil do
// eleitorado" do TSE (dadosabertos.tse.jus.br). Independente de Eleicao
// porque é um dado censitário do ano, não de um pleito específico.
model Eleitorado {
  id          String    @id @default(cuid())
  municipioId String
  municipio   Municipio @relation(fields: [municipioId], references: [id])
  ano         Int
  total       Int

  @@unique([municipioId, ano])
}

// Local de votação (ex: uma escola) dentro do município. Estrutura
// preparada para a importação oficial do TSE; ainda não é populada com
// dados fictícios, então a tabela fica vazia até essa importação existir.
model ColegioEleitoral {
  id          String      @id @default(cuid())
  nome        String
  codigoTse   String?     @unique
  municipioId String
  municipio   Municipio   @relation(fields: [municipioId], references: [id])
  resultados  Resultado[]
  votosLocais VotoLocal[]
}

// Votação nominal por LOCAL DE VOTAÇÃO (escola/colégio), separada de
// Resultado para não interferir nas agregações municipais existentes.
// É a maior tabela do banco (centenas de milhares de linhas por eleição):
// id numérico e um único índice composto para caber no volume de 500MB.
model VotoLocal {
  id                 Int              @id @default(autoincrement())
  candidatoId        String
  candidato          Candidato        @relation(fields: [candidatoId], references: [id])
  colegioEleitoralId String
  colegioEleitoral   ColegioEleitoral @relation(fields: [colegioEleitoralId], references: [id])
  turno              Int              @default(1)
  votos              Int              @default(0)

  @@unique([colegioEleitoralId, candidatoId, turno])
}

model Resultado {
  id                 String            @id @default(cuid())
  candidatoId        String
  candidato          Candidato         @relation(fields: [candidatoId], references: [id])
  municipioId        String
  municipio          Municipio         @relation(fields: [municipioId], references: [id])
  colegioEleitoralId String?
  colegioEleitoral   ColegioEleitoral? @relation(fields: [colegioEleitoralId], references: [id])
  // 1º ou 2º turno (NR_TURNO do TSE) — separados para que majoritários com
  // segundo turno não somem as duas votações.
  turno              Int               @default(1)
  votos              Int               @default(0)
  atualizadoEm       DateTime          @updatedAt

  @@unique([candidatoId, municipioId, colegioEleitoralId, turno])
}

// Votos de legenda (só no partido, sem candidato nominal) por cargo,
// município e turno — arquivo votacao_partido_munzona do TSE. Entram na
// soma dos votos válidos do quociente eleitoral (art. 106).
model VotoLegenda {
  id          String    @id @default(cuid())
  cargoId     String
  cargo       Cargo     @relation(fields: [cargoId], references: [id])
  municipioId String
  municipio   Municipio @relation(fields: [municipioId], references: [id])
  partidoId   String
  partido     Partido   @relation(fields: [partidoId], references: [id])
  turno       Int       @default(1)
  votos       Int       @default(0)

  @@unique([cargoId, municipioId, partidoId, turno])
}

// Pequeno armazenamento chave-valor para controle interno (ex.: data da
// última atualização automática de bancadas).
model ConfigSistema {
  chave        String   @id
  valor        String
  atualizadoEm DateTime @updatedAt
}

// Cenário salvo da meta por município (Criar Cenário): a distribuição
// manual de votos de um pretenso candidato, guardada para as convenções
// municipais — cada organizador cria e alimenta seus cenários possíveis.
model CenarioMeta {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  cargoId       String
  cargo         Cargo    @relation(fields: [cargoId], references: [id])
  titulo        String
  candidatoNome String
  partidoId     String?
  // JSON { municipioId: votos }
  votos         String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Presidência municipal vigente de cada partido (SGIP/TSE) — apoio às
// convenções municipais; só registros com vigência atual são gravados.
model DirecaoMunicipalPartido {
  id          String    @id @default(cuid())
  partidoId   String
  partido     Partido   @relation(fields: [partidoId], references: [id])
  municipioId String
  municipio   Municipio @relation(fields: [municipioId], references: [id])
  presidente  String
  inicio      String?

  @@unique([partidoId, municipioId])
}

// Convenção partidária do ciclo eleitoral corrente (uma por partido):
// datas previstas/realizadas e anotações do organizador.
model Convencao {
  id            String   @id @default(cuid())
  partidoId     String   @unique
  partido       Partido  @relation(fields: [partidoId], references: [id])
  dataPrevista  String?
  dataRealizada String?
  local         String?
  observacoes   String?
  updatedAt     DateTime @updatedAt
}

// Político favorito do usuário: para acompanhar evolução de candidatos
model PoliticoFavorito {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  candidatoId String
  candidato   Candidato @relation(fields: [candidatoId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, candidatoId])
}

// Pré-candidato apontado para as convenções: semeado por pesquisa na
// imprensa ou incluído à mão; após a convenção vira APROVADO (ou
// NAO_APROVADO/desistência), e os aprovados alimentam as simulações.
model PreCandidato {
  id          String   @id @default(cuid())
  partidoId   String
  partido     Partido  @relation(fields: [partidoId], references: [id])
  nome        String
  cargo       String
  situacao    String   @default("PRE_CANDIDATO")
  origem      String   @default("manual")
  observacoes String?
  createdAt   DateTime @default(now())

  @@unique([partidoId, nome, cargo])
}
