generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  COORDENADOR
  CANDIDATO
}

enum TipoEleicao {
  MUNICIPAL
  ESTADUAL
}

enum TipoApuracao {
  MAJORITARIO
  PROPORCIONAL
}

model User {
  id           String     @id @default(cuid())
  nome         String
  email        String     @unique
  passwordHash String
  role         Role       @default(COORDENADOR)
  regiaoId     String?
  regiao       Regiao?    @relation(fields: [regiaoId], references: [id])
  candidatoId  String?
  candidato    Candidato? @relation(fields: [candidatoId], references: [id])
  createdAt    DateTime   @default(now())
}

model Eleicao {
  id        String      @id @default(cuid())
  ano       Int
  uf        String
  tipo      TipoEleicao
  cargos    Cargo[]
  createdAt DateTime    @default(now())
}

// Para cargos municipais (Prefeito/Vereador), municipioId identifica a
// qual município a disputa pertence. Para cargos estaduais (Governador/
// Deputado), municipioId fica nulo pois a disputa é em todo o estado.
model Cargo {
  id           String       @id @default(cuid())
  nome         String
  tipoApuracao TipoApuracao
  vagas        Int          @default(1)
  eleicaoId    String
  eleicao      Eleicao      @relation(fields: [eleicaoId], references: [id])
  municipioId  String?
  municipio    Municipio?   @relation(fields: [municipioId], references: [id])
  candidatos   Candidato[]
}

model Partido {
  id                String         @id @default(cuid())
  sigla             String         @unique
  nome              String
  numero            Int
  candidatos        Candidato[]
  trocasComoOrigem  TrocaPartido[] @relation("TrocaPartidoOrigem")
  trocasComoDestino TrocaPartido[] @relation("TrocaPartidoDestino")
}

model Candidato {
  id            String         @id @default(cuid())
  nome          String
  numero        Int
  cargoId       String
  cargo         Cargo          @relation(fields: [cargoId], references: [id])
  partidoId     String
  partido       Partido        @relation(fields: [partidoId], references: [id])
  resultados    Resultado[]
  users         User[]
  trocasPartido TrocaPartido[]
}

// Registro histórico real de mudança de partido de um candidato (data
// efetiva + motivo opcional). Ao registrar uma troca, o partido atual do
// candidato (Candidato.partidoId) é atualizado para refletir a nova
// filiação nos cálculos de quociente; este log preserva o histórico.
model TrocaPartido {
  id               String    @id @default(cuid())
  candidatoId      String
  candidato        Candidato @relation(fields: [candidatoId], references: [id])
  partidoOrigemId  String
  partidoOrigem    Partido   @relation("TrocaPartidoOrigem", fields: [partidoOrigemId], references: [id])
  partidoDestinoId String
  partidoDestino   Partido   @relation("TrocaPartidoDestino", fields: [partidoDestinoId], references: [id])
  data             DateTime
  motivo           String?
  createdAt        DateTime  @default(now())
}

model Regiao {
  id         String      @id @default(cuid())
  nome       String      @unique
  municipios Municipio[]
  users      User[]
}

model Municipio {
  id                 String             @id @default(cuid())
  nome               String
  codigoIbge         String?            @unique
  codigoTse          String?            @unique
  regiaoId           String
  regiao             Regiao             @relation(fields: [regiaoId], references: [id])
  resultados         Resultado[]
  cargos             Cargo[]
  colegiosEleitorais ColegioEleitoral[]

  @@unique([nome, regiaoId])
}

// Local de votação (ex: uma escola) dentro do município. Estrutura
// preparada para a importação oficial do TSE; ainda não é populada com
// dados fictícios, então a tabela fica vazia até essa importação existir.
model ColegioEleitoral {
  id          String      @id @default(cuid())
  nome        String
  codigoTse   String?     @unique
  municipioId String
  municipio   Municipio   @relation(fields: [municipioId], references: [id])
  resultados  Resultado[]
}

model Resultado {
  id                 String            @id @default(cuid())
  candidatoId        String
  candidato          Candidato         @relation(fields: [candidatoId], references: [id])
  municipioId        String
  municipio          Municipio         @relation(fields: [municipioId], references: [id])
  colegioEleitoralId String?
  colegioEleitoral   ColegioEleitoral? @relation(fields: [colegioEleitoralId], references: [id])
  votos              Int               @default(0)
  atualizadoEm       DateTime          @updatedAt

  @@unique([candidatoId, municipioId, colegioEleitoralId])
}
